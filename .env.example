# Copy to .env for local development (never committed; .env is gitignored).
# Real deployments set these as real environment variables.

# --- Core infrastructure ---
# The control-plane database. External-DB is the default path: point this at
# any Postgres (managed, host-installed, or the shared dev container that
# `task db` provisions via ~/Taskfile.yml).
DATABASE_URL=postgres://dev:dev@localhost:5432/skali_dev?sslmode=disable

# --- Daemon (cmd/skalid) ---
# 7070 by default: 7000 collides with macOS AirPlay on dev machines.
HTTP_ADDR=:7070
# Keys at-rest encryption for the auth system (TOTP secrets). Min 32 chars.
# Generate with: openssl rand -base64 32
# Rotating it invalidates stored TOTP secrets (users must re-enroll 2FA).
AUTH_SECRET=
# Sudo mode: how long after login/reauthentication a session may perform
# security-critical operations without confirming identity again.
# REAUTH_WINDOW=15m

# --- Cluster (reconciliation) ---
# The cluster skalid observes and reconciles. Unset: in-cluster credentials
# are attempted, and without them skalid runs API-only (observation reports
# unknown, nothing reconciles). The ambient KUBECONFIG variable is
# deliberately ignored. Dev: point at the k3d test cluster (task k3d:up).
# SKALI_KUBECONFIG=.k3d/kubeconfig
# RECONCILE_RESYNC_INTERVAL=5m
# RECONCILE_AUDIT_INTERVAL=30m
# RECONCILE_ROLLOUT_DEADLINE=10m
# OBSERVE_STALE_THRESHOLD=30s

# --- Managed registry (builds and imports) ---
# SKALI_REGISTRY_HOST names the registry in artifact references (what build
# clients push and nodes pull); unset disables the build/import surfaces.
# SKALI_REGISTRY_ENDPOINT is what skalid itself dials for digest
# verification (defaults to the host). The local bundle sets all three
# in-cluster; a host-side dev daemon can point at the skali-dev registry:
# SKALI_REGISTRY_HOST=localhost:5510
# SKALI_REGISTRY_ENDPOINT=localhost:5510
# SKALI_REGISTRY_INSECURE=true

# --- Deployment gate and sweeps ---
# Semicolon-separated installation capabilities; revisions needing more are
# rejected at deployment open. R3 serves applications and edge routes.
# SKALI_CAPABILITIES=application;edge
# BUILD_STALE_TIMEOUT=30m

# --- Tests ---
# Read directly by internal/testdb; tests create an ephemeral database per test
# on this server and drop it afterwards. Unset = DB-backed tests are skipped.
# TEST_DATABASE_URL=postgres://dev:dev@localhost:5432/dev?sslmode=disable
# TEST_KUBECONFIG gates live cluster tests (task k3d:up && task test:live).
# TEST_DOCKER=1 gates tests that exec docker (task test:docker).
# TEST_SKALI_DEV=1 gates the skali dev end-to-end suite (task test:dev).

# --- Logging ---
LOG_LEVEL=info      # debug|info|warn|error
LOG_FORMAT=text     # text|json
LOG_OUTPUT=stdout   # stdout|file|both
# LOG_FILE=skali.log

# --- Observability (optional) ---
# Leave unset for zero telemetry egress. Set an OTLP endpoint to enable traces
# & metrics (e.g. a local SigNoz or OpenTelemetry Collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console   # dev alternative: print spans to stdout
