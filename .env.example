# Copy to .env for local development (never committed; .env is gitignored).
# Real deployments set these as real environment variables.

# --- Core infrastructure ---
# The control-plane database. External-DB is the default path: point this at
# any Postgres (managed, host-installed, or the shared dev container that
# `task db` provisions via ~/Taskfile.yml). Later, skalid can instead spin up
# its own Postgres through its container engine (--db-port etc.).
DATABASE_URL=postgres://dev:dev@localhost:5432/skali_dev?sslmode=disable

# --- Daemon (cmd/skalid) ---
# 7070 by default: 7000 collides with macOS AirPlay on dev machines.
HTTP_ADDR=:7070
# Keys at-rest encryption for the auth system (TOTP secrets). Min 32 chars.
# Generate with: openssl rand -base64 32
# Rotating it invalidates stored TOTP secrets (users must re-enroll 2FA).
AUTH_SECRET=
# Sudo mode: how long after login/reauthentication a session may perform
# security-critical operations without confirming identity again.
# REAUTH_WINDOW=15m

# --- Cluster (multi-node) ---
# The master's cluster-plane listener (TLS gRPC): serves node enrollment.
# GRPC_ADDR=:7443
# Externally reachable host:port of GRPC_ADDR, as other machines see it. Baked
# into the `skalid enroll` command rendered when minting a join token; minting
# fails while unset. Single-node setups can leave it unset.
# CLUSTER_ADDR=10.0.0.1:7443

# --- Worker / agent (skalid enroll + skalid agent; no database) ---
# Where the node identity lives (CA cert, node cert+key, node metadata).
# DATA_DIR=/var/lib/skalid
# The worker's NodeService listener the master dials (same variable as the
# master's GRPC_ADDR — a machine runs either serve or agent, not both).
# GRPC_ADDR=:7443

# --- Tests ---
# Read directly by internal/testdb; tests create an ephemeral database per test
# on this server and drop it afterwards. Unset = DB-backed tests are skipped.
# TEST_DATABASE_URL=postgres://dev:dev@localhost:5432/dev?sslmode=disable

# --- Logging ---
LOG_LEVEL=info      # debug|info|warn|error
LOG_FORMAT=text     # text|json
LOG_OUTPUT=stdout   # stdout|file|both
# LOG_FILE=skali.log

# --- Observability (optional) ---
# Leave unset for zero telemetry egress. Set an OTLP endpoint to enable traces
# & metrics (e.g. a local SigNoz or OpenTelemetry Collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console   # dev alternative: print spans to stdout
