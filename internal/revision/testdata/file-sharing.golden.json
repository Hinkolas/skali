{
  "schemaVersion": "1",
  "project": "file-sharing",
  "environment": "production",
  "compilerVersion": "test",
  "definitionHash": "c958075f686d42798f414059e3f009a53bce677608f08764a367d8adbeb22438",
  "definition": {
    "version": "1",
    "name": "file-sharing",
    "description": "Full-stack file-sharing application with PostgreSQL and S3 storage",
    "applications": {
      "web": {
        "source": {
          "kind": "build",
          "build": {
            "context": "web",
            "dockerfile": "deploy/Dockerfile",
            "target": "runtime"
          }
        },
        "command": [
          "/app/file-sharing",
          "serve"
        ],
        "environment": {
          "NODE_ENV": {
            "parts": [
              {
                "kind": "literal",
                "value": "production"
              }
            ]
          },
          "POSTGRES_DATABASE": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "name"
              }
            ]
          },
          "POSTGRES_HOST": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "host"
              }
            ]
          },
          "POSTGRES_PASSWORD": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "password",
                "sensitive": true
              }
            ]
          },
          "POSTGRES_PORT": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "port"
              }
            ]
          },
          "POSTGRES_USER": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "username",
                "sensitive": true
              }
            ]
          },
          "S3_ACCESS_KEY": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "access_key",
                "sensitive": true
              }
            ]
          },
          "S3_BUCKET": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "name"
              }
            ]
          },
          "S3_ENDPOINT": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "endpoint"
              }
            ]
          },
          "S3_REGION": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "region"
              }
            ]
          },
          "S3_SECRET_KEY": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "secret_key",
                "sensitive": true
              }
            ]
          },
          "SESSION_SECRET": {
            "parts": [
              {
                "kind": "project_variable",
                "name": "SESSION_SECRET"
              }
            ]
          }
        },
        "ports": {
          "http": {
            "port": 8080,
            "protocol": "http"
          }
        },
        "routes": {
          "public": {
            "domain": {
              "parts": [
                {
                  "kind": "project_variable",
                  "name": "APP_DOMAIN"
                }
              ]
            },
            "path": "/",
            "port": {
              "name": "http"
            },
            "tls": "automatic"
          }
        },
        "health": {
          "startup": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/startup"
            },
            "intervalMillis": 2000,
            "timeoutMillis": 2000,
            "failureThreshold": 30
          },
          "readiness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/ready"
            },
            "intervalMillis": 10000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          },
          "liveness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/live"
            },
            "intervalMillis": 30000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          }
        },
        "resources": {
          "requests": {
            "milliCpu": 200,
            "memoryBytes": 256000000,
            "temporaryStorageBytes": 256000000
          },
          "limits": {
            "milliCpu": 1000,
            "memoryBytes": 1000000000,
            "temporaryStorageBytes": 2000000000
          }
        },
        "scaling": {
          "minReplicas": 2,
          "maxReplicas": 5,
          "cpuTargetUtilization": 70
        },
        "placement": {
          "spreadAcross": "nodes",
          "minimum": 2,
          "enforcement": "preferred"
        },
        "deployment": {
          "releaseCommand": {
            "command": [
              "/app/file-sharing",
              "migrate",
              "up"
            ],
            "timeoutMillis": 300000
          },
          "rollout": {
            "strategy": "rolling",
            "maxSurge": 1,
            "timeoutMillis": 600000
          }
        },
        "shutdown": {
          "gracePeriodMillis": 30000
        }
      }
    },
    "databases": {
      "data": {
        "engine": "postgres",
        "version": "17",
        "isolation": "project",
        "availability": "single",
        "storageBytes": 20000000000,
        "extensions": [
          "pg_trgm"
        ]
      }
    },
    "buckets": {
      "files": {
        "visibility": "private",
        "storageQuotaBytes": 20000000000,
        "versioning": "disabled"
      }
    },
    "backups": {
      "daily": {
        "schedule": "0 3 * * *",
        "retentionSeconds": 604800,
        "include": {
          "allDatabases": true,
          "allBuckets": true,
          "allVolumes": true
        }
      }
    },
    "requiredVariables": [
      {
        "name": "APP_DOMAIN",
        "required": true
      },
      {
        "name": "SESSION_SECRET",
        "required": true
      }
    ],
    "dependencies": {
      "applications.web": [
        "buckets.files",
        "databases.data"
      ]
    }
  },
  "valuesHash": "5882e4b21146aac54fbbfb82062266c8596e2f42ccd4bbf072876e003985bc72",
  "secrets": {
    "APP_DOMAIN": {
      "version": 1
    },
    "SESSION_SECRET": {
      "version": 1
    }
  },
  "artifacts": {
    "web": {
      "reference": "registry.skali.internal/skali/file-sharing/web",
      "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "kind": "build-local",
      "contextHash": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    }
  },
  "capabilities": [
    "application",
    "database",
    "object-storage",
    "edge"
  ],
  "checksum": "cddcc8f972240778712ee105e38c517a22daf3eec3ea61fbdca2899f057a625b"
}
