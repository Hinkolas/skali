{
  "schema": 1,
  "project": "file-sharing",
  "environment": "production",
  "compilerVersion": "test",
  "definitionHash": "2680dfa05d2bcf656544291a735e0cacae2ce8363afa6746639b6eb0b63d5c1f",
  "definition": {
    "schema": 1,
    "name": "file-sharing",
    "description": "Presigned-URL reference application with a project-isolated PostgreSQL database and an S3 bucket",
    "applications": {
      "web": {
        "source": {
          "kind": "build",
          "build": {
            "context": "web",
            "dockerfile": "web/deploy/Dockerfile",
            "target": "runtime"
          }
        },
        "command": [
          "/app/file-sharing",
          "serve"
        ],
        "environment": {
          "POSTGRES_DATABASE": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "name"
              }
            ]
          },
          "POSTGRES_HOST": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "host"
              }
            ]
          },
          "POSTGRES_PASSWORD": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "password",
                "sensitive": true
              }
            ]
          },
          "POSTGRES_PORT": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "port"
              }
            ]
          },
          "POSTGRES_USER": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "databases",
                "service": "data",
                "output": "username",
                "sensitive": true
              }
            ]
          },
          "PRESIGN_TTL": {
            "parts": [
              {
                "kind": "project_variable",
                "name": "PRESIGN_TTL",
                "default": "15m",
                "hasDefault": true
              }
            ]
          },
          "S3_ACCESS_KEY": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "access_key",
                "sensitive": true
              }
            ]
          },
          "S3_BUCKET": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "name"
              }
            ]
          },
          "S3_ENDPOINT": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "endpoint"
              }
            ]
          },
          "S3_INTERNAL_ENDPOINT": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "internal_endpoint"
              }
            ]
          },
          "S3_PUBLIC_ENDPOINT": {
            "parts": [
              {
                "kind": "project_variable",
                "name": "S3_PUBLIC_ENDPOINT",
                "hasDefault": true
              }
            ]
          },
          "S3_REGION": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "region"
              }
            ]
          },
          "S3_SECRET_KEY": {
            "parts": [
              {
                "kind": "service_output",
                "collection": "buckets",
                "service": "files",
                "output": "secret_key",
                "sensitive": true
              }
            ]
          },
          "UPLOAD_TOKEN": {
            "parts": [
              {
                "kind": "project_variable",
                "name": "UPLOAD_TOKEN"
              }
            ]
          }
        },
        "ports": {
          "http": {
            "port": 8080,
            "protocol": "http"
          }
        },
        "routes": {
          "public": {
            "domain": {
              "parts": [
                {
                  "kind": "project_variable",
                  "name": "APP_DOMAIN"
                }
              ]
            },
            "path": "/",
            "port": {
              "name": "http"
            },
            "tls": "automatic",
            "strategy": "round-robin"
          }
        },
        "health": {
          "startup": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/startup"
            },
            "intervalMillis": 2000,
            "timeoutMillis": 2000,
            "failureThreshold": 30
          },
          "readiness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/ready"
            },
            "intervalMillis": 10000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          },
          "liveness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/health/live"
            },
            "intervalMillis": 30000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          }
        },
        "resources": {
          "requests": {
            "milliCpu": 200,
            "memoryBytes": 256000000,
            "temporaryStorageBytes": 256000000
          },
          "limits": {
            "milliCpu": 1000,
            "memoryBytes": 1000000000,
            "temporaryStorageBytes": 2000000000
          }
        },
        "scaling": {
          "minReplicas": 2,
          "maxReplicas": 5,
          "cpuTargetUtilization": 70
        },
        "placement": {
          "spreadAcross": "nodes",
          "minimum": 2,
          "enforcement": "preferred"
        },
        "deployment": {
          "releaseCommand": {
            "command": [
              "/app/file-sharing",
              "migrate",
              "up"
            ],
            "timeoutMillis": 300000
          },
          "rollout": {
            "strategy": "rolling",
            "maxSurge": 1,
            "timeoutMillis": 600000
          }
        },
        "shutdown": {
          "gracePeriodMillis": 30000
        }
      }
    },
    "databases": {
      "data": {
        "engine": "postgres",
        "version": "17",
        "isolation": "project",
        "availability": "single",
        "storageBytes": 20000000000,
        "extensions": [
          "pg_trgm"
        ]
      }
    },
    "buckets": {
      "files": {
        "visibility": "private",
        "storageQuotaBytes": 20000000000,
        "versioning": "disabled",
        "abortIncompleteUploadsAfterSeconds": 21600,
        "route": {
          "domain": {
            "parts": [
              {
                "kind": "project_variable",
                "name": "STORAGE_DOMAIN"
              }
            ]
          },
          "tls": "automatic"
        }
      }
    },
    "requiredVariables": [
      {
        "name": "APP_DOMAIN",
        "required": true
      },
      {
        "name": "PRESIGN_TTL",
        "required": false,
        "default": "15m",
        "hasDefault": true
      },
      {
        "name": "S3_PUBLIC_ENDPOINT",
        "required": false,
        "hasDefault": true
      },
      {
        "name": "STORAGE_DOMAIN",
        "required": true
      },
      {
        "name": "UPLOAD_TOKEN",
        "required": true
      }
    ],
    "dependencies": {
      "applications.web": [
        "buckets.files",
        "databases.data"
      ]
    }
  },
  "valuesHash": "765447b6565f7347f699024e9ffc7ad728bb1da4d076fcb1446c3395eda3a605",
  "secrets": {
    "APP_DOMAIN": {
      "version": 1
    },
    "STORAGE_DOMAIN": {
      "version": 1
    },
    "UPLOAD_TOKEN": {
      "version": 1
    }
  },
  "artifacts": {
    "web": {
      "reference": "registry.skali.internal/skali/file-sharing/web",
      "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "kind": "build-local",
      "contextHash": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    }
  },
  "capabilities": [
    "application",
    "database",
    "object-storage",
    "edge"
  ],
  "checksum": "18348dbc0ce99391c4c2635a66eb5d14584ab4dbf18f91cf89e4140285596bf7"
}
