  "definition": {
    "version": "1",
    "name": "hello-world",
    "description": "Minimal build-sourced HTTP application (the local-build flagship)",
    "applications": {
      "web": {
        "source": {
          "kind": "build",
          "build": {
            "context": ".",
            "dockerfile": "Dockerfile"
          }
        },
        "ports": {
          "http": {
            "port": 8080,
            "protocol": "http"
          }
        },
        "routes": {
          "public": {
            "domain": {
              "parts": [
                {
                  "kind": "project_variable",
                  "name": "APP_DOMAIN"
                }
              ]
            },
            "path": "/",
            "port": {
              "name": "http"
            },
            "tls": "automatic"
          }
        },
        "health": {
          "readiness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/healthz"
            },
            "intervalMillis": 5000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          },
          "liveness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/healthz"
            },
            "intervalMillis": 30000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          }
        },
        "scaling": {
          "minReplicas": 3,
          "maxReplicas": 3
        },
        "deployment": {
          "rollout": {
            "strategy": "rolling",
            "maxSurge": 1
          }
        },
        "shutdown": {
          "gracePeriodMillis": 30000
        }
      }
    },
    "requiredVariables": [
      {
        "name": "APP_DOMAIN",
        "required": true
      }
    ]
  },
  "valuesHash": "60d7cbaf16f6a97b16ecc928e7791f691a8cbe9762270591baf025ca6e7840c0",
  "secrets": {
    "APP_DOMAIN": {
      "version": 1
    }
  },
