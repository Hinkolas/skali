  "definition": {
    "version": "1",
    "name": "hello-world",
    "description": "Minimal build-sourced HTTP application (the local-build flagship)",
    "applications": {
      "web": {
        "source": {
          "kind": "build",
          "build": {
            "context": ".",
            "dockerfile": "Dockerfile"
          }
        },
        "ports": {
          "http": {
            "port": 8080,
            "protocol": "http"
          }
        },
        "routes": {
          "public": {
            "domain": {
              "parts": [
                {
                  "kind": "project_variable",
                  "name": "APP_DOMAIN"
                }
              ]
            },
            "path": {
              "parts": [
                {
                  "kind": "literal",
                  "value": "/"
                }
              ]
            },
            "port": {
              "name": "http"
            },
            "tls": "automatic"
          }
        },
        "health": {
          "readiness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": {
                "parts": [
                  {
                    "kind": "literal",
                    "value": "/healthz"
                  }
                ]
              }
            },
            "intervalMillis": 5000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          },
          "liveness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": {
                "parts": [
                  {
                    "kind": "literal",
                    "value": "/healthz"
                  }
                ]
              }
            },
            "intervalMillis": 30000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          }
        },
        "scaling": {
          "minReplicas": 3,
          "maxReplicas": 3
        },
        "deployment": {
          "rollout": {
            "strategy": "rolling",
            "maxSurge": 1
          }
        },
        "shutdown": {
          "gracePeriodMillis": 30000
        }
      }
    },
    "requiredVariables": [
      {
        "name": "APP_DOMAIN",
        "required": true,
        "runtime": true
      }
    ]
  },
