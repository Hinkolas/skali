{
  "schemaVersion": "1",
  "project": "hello-world",
  "environment": "production",
  "compilerVersion": "test",
  "definitionHash": "9bbe35e68acd9a8ebc71f6b4f5f2fb2e65cf9b9c0fc1651e38b43b6d4c0f9ddc",
  "definition": {
    "version": "1",
    "name": "hello-world",
    "description": "Minimal build-sourced HTTP application (the local-build flagship)",
    "applications": {
      "web": {
        "source": {
          "kind": "build",
          "build": {
            "context": ".",
            "dockerfile": "Dockerfile"
          }
        },
        "ports": {
          "http": {
            "port": 8080,
            "protocol": "http"
          }
        },
        "routes": {
          "public": {
            "domain": {
              "parts": [
                {
                  "kind": "project_variable",
                  "name": "APP_DOMAIN"
                }
              ]
            },
            "path": "/",
            "port": {
              "name": "http"
            },
            "tls": "automatic"
          }
        },
        "health": {
          "readiness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/healthz"
            },
            "intervalMillis": 5000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          },
          "liveness": {
            "http": {
              "port": {
                "name": "http"
              },
              "path": "/healthz"
            },
            "intervalMillis": 30000,
            "timeoutMillis": 2000,
            "failureThreshold": 3
          }
        },
        "scaling": {
          "minReplicas": 3,
          "maxReplicas": 3
        },
        "deployment": {
          "rollout": {
            "strategy": "rolling",
            "maxSurge": 1
          }
        },
        "shutdown": {
          "gracePeriodMillis": 30000
        }
      }
    },
    "requiredVariables": [
      {
        "name": "APP_DOMAIN",
        "required": true
      }
    ]
  },
  "valuesHash": "0f2653b428522ff0f936fa5a5b6debeb42699043c9abe02bae450637fec18e4b",
  "values": {
    "APP_DOMAIN": "hello.example.com"
  },
  "artifacts": {
    "web": {
      "reference": "registry.skali.internal/skali/hello-world/web",
      "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "kind": "build-local",
      "contextHash": "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    }
  },
