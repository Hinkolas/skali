# Rendered by skali cluster. The Lima instance is the single source of
# truth for VM sizing and network mode; there is no separate state file.
minimumLimaVersion: "1.0.0"

images:
  - location: "https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-arm64.img"
    arch: "aarch64"
  - location: "https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.img"
    arch: "x86_64"

vmType: "vz"
cpus: {{.CPUs}}
memory: "{{.Memory}}"
disk: "{{.Disk}}"

# A skali node exposes nothing of the Mac.
mounts: []

# k3s brings its own containerd inside the guest.
containerd:
  system: false
  user: false

networks:
  - lima: {{.Network}}
{{- if .ForwardPort}}

# On user-v2 the Mac cannot reach guest addresses; this explicit rule
# forwards the Kubernetes API to host loopback instead.
portForwards:
  - guestPort: 6443
    hostPort: {{.ForwardPort}}
{{- end}}

# The guest hostname becomes the k3s node name. Without this every Mac
# would produce the same lima-<instance> node name and collide in one
# cluster. hostnamectl is idempotent, so re-running per boot is harmless.
provision:
  - mode: system
    script: |
      #!/bin/sh
      hostnamectl set-hostname {{.Hostname}}
  # Longhorn needs iscsid on every node that may attach a volume. Boot-time
  # install keeps a fresh VM ready before skali cluster install runs; the
  # installer's storage-prerequisites step covers VMs created before this
  # template carried it. Best effort: apt failures leave the marker absent
  # and the installer step retries with real error reporting.
  - mode: system
    script: |
      #!/bin/sh
      set -e
      if [ -e /var/lib/skali-storage-prereqs ]; then exit 0; fi
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq
      apt-get install -y open-iscsi
      systemctl enable --now iscsid
      touch /var/lib/skali-storage-prereqs
